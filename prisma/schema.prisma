generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model File {
  id               String       @id
  name             String
  uploadStatus     UploadStatus @default(PENDING)
  url              String
  key              String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime
  userId           String?
  agentDescription String       @default("Agente de atendimento para informações gerais")
  agentName        String       @default("Agente IA")
  agentNumber      String?
  agentTitle       String       @default("Agente IA")
  agentType        String       @default("Atendente")
  isAtive          Boolean      @default(false)
  isConnected      Boolean      @default(false)
  User             User?        @relation(fields: [userId], references: [id])
  Message          Message[]
}

model Message {
  id            String   @id
  text          String
  isUserMessage Boolean
  createdAt     DateTime @default(now())
  updatedAt     DateTime
  userId        String?
  fileId        String?
  File          File?    @relation(fields: [fileId], references: [id])
  User          User?    @relation(fields: [userId], references: [id])
}

model User {
  id    String @id @unique //matches kinde user id
  email String @unique

  File    File[]
  Message Message[]
  Agent   Agent[]

  stripeCustomerId       String?   @unique @map(name: "stripe_customer_id")
  stripeSubscriptionId   String?   @unique @map(name: "stripe_subscription_id")
  stripePriceId          String?   @map(name: "stripe_price_id")
  stripeCurrentPeriodEnd DateTime? @map(name: "stripe_current_period_end")
}

model Contact {
  id          String       @id @default(cuid())
  email       String?
  name        String?
  phone       String
  threadId    String?
  isSeen      Boolean      @default(false)
  lastMessage String?
  timestamp   DateTime     @default(now())
  agentId     String       @default("1")
  isAdmin     Boolean      @default(false)
  apiKey      String? // API key del usuario
  agent       Agent        @relation(fields: [agentId], references: [id])
  hubMessages HubMessage[]

  @@unique([phone, agentId], name: "phone_agentId_unique")
}

// Alineado con el schema de la plataforma (hubility-agents-sdk/prisma/schema.prisma).
// loadAgentConfig() del SDK selecciona name/model/temperature/verbosity/systemPrompt/
// adminSystemPrompt/isActive/envVariables con el cliente generado por ESTE schema.
// NO usar prisma db push/migrate: la DB ya está al día.
model Agent {
  id                String             @id @default(cuid())
  key               String             @unique @default(cuid())
  isActive          Boolean            @default(false)
  isConnected       Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  apiKey            String?
  description       String?
  groupName         String?
  model             String             @default("gpt-4o")
  name              String
  ownerId           String
  systemPrompt      String
  temperature       Float?
  type              String             @default("General")
  phoneNumberId     String?            @unique
  agentEndpoint     String?
  tone              String             @default("formal")
  verbosity         Int                @default(2)
  railwayProjectId  String?            @unique
  welcomeMessage    String?
  welcomeButton     String?
  adminSystemPrompt String?
  owner             User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  envVariables      AgentEnvVariable[]
  contacts          Contact[]
  events            AgentEvent[]
  AgentRule         AgentRule[]
}

model AgentRule {
  id        String   @id @default(cuid())
  agentId   String
  content   String
  isActive  Boolean  @default(true)
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  Agent     Agent    @relation(fields: [agentId], references: [id])

  @@index([agentId, isActive])
}

model AgentEnvVariable {
  id       String  @id @default(cuid())
  agentId  String
  key      String
  value    String
  isSecret Boolean @default(false)
  agent    Agent   @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, key])
}

model HubMessage {
  id            String      @id @default(cuid())
  text          String
  messageType   MessageType
  isUserMessage Boolean
  isSeen        Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  contactId     String
  contact       Contact     @relation(fields: [contactId], references: [id])
}

model ClientProfile {
  id                     String  @id @default(cuid())
  phone                  String  @default("update")
  name                   String
  email                  String?
  numberOfChildrens      String?
  age                    String
  profession             String
  employmentContractType String
  employmentDuration     String
  monthlyNetIncome       String
  currentLoanPayments    String
  outstandingLoanAmount  String
  personalSituation      String
  numberOfHolders        String
  propertyValue          Float
  propertyLocation       String
  downPayment            Float
  profileType            String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UploadStatus {
  PENDING
  PROCESSING
  FAILED
  SUCCESS
}

enum MessageType {
  DOCUMENT
  IMAGE
  TEXT
  AUDIO
}

// ============================================================================
// Agent Events System
// ============================================================================

enum EventSeverity {
  ERROR
  WARNING
  SUCCESS
  INFO
}

enum EventCategory {
  INTEGRATION
  TOOL
  MESSAGING
  ATTACHMENTS
  SYSTEM
}

model AgentEvent {
  id            String   @id @default(cuid())
  correlationId String   @default(cuid())
  timestamp     DateTime @default(now())

  // Severity levels
  severity EventSeverity

  // Origin information
  category   EventCategory
  originName String // e.g., "WhatsApp Integration", "searchProducts"
  channel    String? // e.g., "WhatsApp", "Email"

  // Event content
  summary  String
  details  String @db.Text
  duration Int? // Execution duration in ms
  payload  Json? // Additional context

  // Relations
  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([timestamp])
  @@index([severity])
  @@index([category])
}
